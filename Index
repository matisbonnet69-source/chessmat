 const fin=m=>{BD.sel=-1;BD.targets=new Set();BD.noAnim=!!viaDrag;BD.onMove(m);BD.noAnim=false;};
 if(ms.length>1)promoPicker(BD.state.turn,pr=>fin(ms.find(x=>x.promo===pr)),()=>{renderBoard();});else fin(ms[0]);}
