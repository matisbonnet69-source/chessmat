  // renvoie {over, result:'w'|'b'|'draw', reason}
  function status(s, keys) {
    const mv = legal(s);
    if (!mv.length) return inCheck(s) ? { over: true, result: s.turn === 'w' ? 'b' : 'w', reason: 'mat' } : { over: true, result: 'draw', reason: 'pat' };
    if (insufficient(s.b)) return { over: true, result: 'draw', reason: 'matériel insuffisant' };
    if (s.half >= 100) return { over: true, result: 'draw', reason: 'règle des 50 coups' };
    if (keys) { const k = key(s); let n = 0; for (const x of keys) if (x === k) n++; if (n >= 3) return { over: true, result: 'draw', reason: 'triple répétition' }; }
