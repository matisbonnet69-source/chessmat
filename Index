function netClose(){try{if(NET.conn)NET.conn.close();}catch(e){}try{if(NET.peer)NET.peer.destroy();}catch(e){}NET.conn=NET.peer=null;NET.want=NET.oppWants=false;}
const mkCode=()=>{const a='ABCDEFGHJKLMNPQRSTUVWXYZ23456789';let s='';for(let i=0;i<5;i++)s+=a[rnd(a.length)];return s;};
function netCreate(){if(typeof Peer==='undefined'){toast('Service en ligne indisponible (PeerJS non chargé). Vérifie ta connexion.',4000);return;}
 netClose();NET.host=true;NET.code=mkCode();const p=NET.peer=new Peer('rnr-'+NET.code);
 p.on('open',()=>hostWaiting());p.on('connection',c=>{if(NET.conn&&NET.conn.open){c.close();return;}bindConn(c);});
 p.on('error',e=>{if(e.type==='unavailable-id')netCreate();else toast('Erreur réseau : '+e.type,4000);});}
function netJoin(code){if(typeof Peer==='undefined'){toast('Service en ligne indisponible (PeerJS non chargé).',4000);return;}
 netClose();NET.host=false;code=code.trim().toUpperCase();openModal(`<h2>Connexion…</h2><p style="color:var(--mut)">Salon <b>${code}</b> <span class="dots"></span></p><button class="btn" id="cx">Annuler</button>`,{onclose:netClose});$('#cx').onclick=()=>{closeModal(true);netClose();};
 const p=NET.peer=new Peer();p.on('open',()=>{const c=p.connect('rnr-'+code,{reliable:true});bindConn(c);setTimeout(()=>{if(NET.conn===c&&!c.open){toast('Salon introuvable ou injoignable',3500);closeModal(true);netClose();}},12000);});
 p.on('error',e=>{closeModal(true);toast(e.type==='peer-unavailable'?'Code introuvable. Vérifie-le !':'Erreur réseau : '+e.type,4000);});}
function bindConn(c){NET.conn=c;c.on('open',()=>{if(!NET.host)netSend({t:'hello',name:P.name});});c.on('data',onNet);c.on('close',()=>{if(G&&G.mode==='online'&&!G.over){toast('Ton ami s\'est déconnecté 😢',3500);if(G.hist.length>2)endGame(G.my,'adversaire déconnecté');}});c.on('error',()=>{});}
function hostWaiting(){const link=location.href.split('#')[0]+'#room='+NET.code;
 const b=openModal(`<h2>Salon créé ✨</h2><p style="color:var(--mut);margin:0">Envoie ce code (ou le lien) à ton ami :</p><div class="code">${NET.code}</div>
 <div class="row" style="justify-content:center"><button class="btn pri" id="cpL">🔗 Copier le lien</button><button class="btn" id="cpC">Copier le code</button><button class="btn" id="shr">📤 Partager</button></div>
 <p style="color:var(--mut);text-align:center;margin-top:14px">En attente de ton ami<span class="dots"></span></p><p style="color:var(--mut);font-size:12px">Astuce : si tu n'héberges pas le site, ton ami peut ouvrir sa propre copie du fichier et entrer le code.</p><button class="btn" id="cx">Annuler</button>`,{onclose:netClose});
 const cp=t=>(navigator.clipboard?navigator.clipboard.writeText(t):Promise.reject()).then(()=>toast('Copié ✅'),()=>toast(t,6000));
 b.querySelector('#cpL').onclick=()=>cp(link);b.querySelector('#cpC').onclick=()=>cp(NET.code);b.querySelector('#cx').onclick=()=>{closeModal(true);netClose();};
 b.querySelector('#shr').onclick=()=>{if(navigator.share)navigator.share({title:"Roque'n'Roll",text:'Viens jouer aux échecs avec moi ! Code : '+NET.code,url:link}).catch(()=>{});else cp(link);};}
function onlineStart(my,oppName,tc){const names={};names[my]=P.name;names[my==='w'?'b':'w']=oppName||'Ami';startGame({mode:'online',my,names,tc});G.ready=true;updateUI();}
function hostBegin(guest){const pref=NET.pref==='r'?(rnd(2)?'w':'b'):NET.pref;netSend({t:'start',color:pref==='w'?'b':'w',tc:NET.tc,name:P.name});onlineStart(pref,guest,NET.tc);}
function onNet(m){if(!m||!m.t)return;switch(m.t){
 case'hello':if(NET.host)hostBegin(m.name);break;
 case'start':onlineStart(m.color,m.name,m.tc);NET.want=NET.oppWants=false;break;
 case'move':{if(!G||G.over||G.mode!=='online'||G.state.turn===G.my)break;const mv=fromUci(G.state,m.u);if(mv)doMove(mv,true);break;}
 case'resign':if(G&&!G.over)endGame(G.my,'abandon de l\'adversaire');break;
 case'flag':if(G&&!G.over)endGame(G.my,'temps écoulé');break;
 case'draw':if(G&&!G.over){const b=openModal(`<h2>🤝 Nulle ?</h2><p>Ton ami propose la nulle.</p><div class="row"><button class="btn pri" id="y">Accepter</button><button class="btn" id="n">Refuser</button></div>`,{closable:false});b.querySelector('#y').onclick=()=>{closeModal(true);netSend({t:'drawAns',y:1});endGame('draw','accord mutuel');};b.querySelector('#n').onclick=()=>{closeModal(true);netSend({t:'drawAns',y:0});};}break;
 case'drawAns':if(G&&!G.over){if(m.y)endGame('draw','accord mutuel');else toast('Nulle refusée');}break;
 case'emo':floatEmo(m.e,false);break;
 case'rematch':NET.oppWants=true;toast('Ton ami veut une revanche ⚔️');if(NET.host&&NET.want)doRematch();break;}}
function rematch(){NET.want=true;netSend({t:'rematch'});toast('Revanche demandée…');if(NET.host&&NET.oppWants)doRematch();}
function doRematch(){const my=G.my==='w'?'b':'w';netSend({t:'start',color:my==='w'?'b':'w',tc:G.tc,name:P.name});const opp=G.names[G.my==='w'?'b':'w'];onlineStart(my,opp,G.tc);NET.want=NET.oppWants=false;}

/* ===== Puzzles Rush ===== */
const PZ={active:false,cur:null,state:null,node:null,me:'w',failed:false,hinted:0,done:false,busy:false,lives:3,streak:0,best:0,run:0,startRating:800,timer:null,solTimer:null};
const STAR=n=>'★'.repeat(n)+'☆'.repeat(3-n);
function startPuzzles(){closeModal(true);cancelBot();G=null;show('stage');PZ.active=true;PZ.lives=3;PZ.streak=0;PZ.best=0;PZ.run=0;PZ.startRating=P.rating;
 $('#panelGame').hidden=true;$('#panelPuzzle').hidden=false;$('#puzHud').hidden=false;$('#barTop').hidden=$('#barBot').hidden=true;
 BD.interactive=()=>PZ.active&&!PZ.busy&&!PZ.done;BD.canPick=p=>colorOf(p)===PZ.me&&PZ.state.turn===PZ.me;BD.onMove=puzzleMove;
 puzHud();nextPuzzle();}
function stopPuz(){PZ.active=false;clearTimeout(PZ.timer);clearTimeout(PZ.solTimer);document.documentElement.style.setProperty('--h',265);}
function pickPuzzle(){let seen=new Set(P.seen),pool=PUZZLES.filter(p=>!seen.has(p.fen));if(!pool.length){P.seen=[];pool=PUZZLES.slice();}
 const tgt=P.rating+40;pool.sort((a,b)=>Math.abs(a.r-tgt)-Math.abs(b.r-tgt));const top=pool.slice(0,4);return top[rnd(top.length)];}
function nextPuzzle(){clearTimeout(PZ.timer);clearTimeout(PZ.solTimer);const p=pickPuzzle();PZ.cur=p;P.seen.push(p.fen);if(P.seen.length>800)P.seen.shift();save();
 PZ.state=fromFEN(p.fen);PZ.node=p.tree||null;PZ.me=PZ.state.turn;PZ.failed=false;PZ.hinted=0;PZ.done=false;PZ.busy=false;
 BD.flip=PZ.me==='b';BD.last=null;setPosition(PZ.state,{last:null});cls1(boardEl,'pop',600);
 $('#pzNext').hidden=true;$('#pzHint').hidden=$('#pzSol').hidden=$('#pzSkip').hidden=false;
 $('#pzTitle').innerHTML=`Mat en ${p.n} <span style="color:#ffd23f">${STAR(p.n)}</span> <span style="color:var(--mut);font-weight:600;font-size:14px">· difficulté ${p.r}</span>`;
 $('#pzPrompt').textContent=`Les ${PZ.me==='w'?'Blancs':'Noirs'} jouent et matent en ${p.n} coup${p.n>1?'s':''}. Trouve la séquence !`;puzHud();}
function puzHud(){const h=$('#hearts');h.textContent='❤️'.repeat(PZ.lives)+'🖤'.repeat(3-PZ.lives);const c=$('#combo');c.textContent='🔥 x'+PZ.streak;c.style.opacity=PZ.streak?1:.45;
 const hue=(265+PZ.streak*22)%360;document.documentElement.style.setProperty('--h',hue);$('#pillStreak').hidden=!PZ.active;$('#hudStreak').textContent=PZ.streak;
 const q=quest();$('#pzQuest').textContent=q.claimed?'✅ Quête du jour accomplie !':`🎯 Quête du jour : ${q.n}/5`;$('#pzRun').textContent=`Cette série : ${PZ.run} résolu${PZ.run>1?'s':''} · record ${PZ.best} 🔥 · rating ${Math.round(PZ.startRating)} → ${Math.round(P.rating)}`;hud();}
function ratingChange(success,mult){const p=PZ.cur,exp=1/(1+Math.pow(10,(p.r-P.rating)/400)),K=34;let d=success?K*(1-exp)*mult:-K*exp;d=Math.round(d);const old=P.rating;P.rating=Math.max(400,P.rating+d);save();
 tween($('#zRating'),old,P.rating,900);tween($('#hudRating'),old,P.rating,900);return d;}
function puzzleMove(m){const s=PZ.state,ns=apply(s,m),u=uci(m),mate=inCheck(ns)&&!legal(ns).length,known=PZ.node&&PZ.node[u];
 if(mate){PZ.state=ns;setPosition(ns,{last:{from:m.from,to:m.to},anim:an(m)});const[x,y]=centerOf(m.to);Snd.move();FX.burst(x,y,'#ff4d4d',50);return puzzleSolved();}
 if(known){PZ.state=ns;setPosition(ns,{last:{from:m.from,to:m.to},anim:an(m)});Snd.good();vib(20);PZ.busy=true;PZ.node=known[1];const[x,y]=boardCenter();pop('Bien joué ! Continue…',x,y,'good');
  PZ.timer=setTimeout(()=>{const rm=fromUci(ns,known[0]),s2=apply(ns,rm);PZ.state=s2;setPosition(s2,{last:{from:rm.from,to:rm.to},anim:{from:rm.from,to:rm.to}});Snd.move();PZ.busy=false;},560);return;}
 puzzleWrong(m,ns);}
function puzzleWrong(m,ns){const prev=PZ.state;PZ.busy=true;setPosition(ns,{last:{from:m.from,to:m.to},anim:an(m)});Snd.wrong();vib([120,60,120]);cls1(boardEl,'shake');const[x,y]=boardCenter();
 if(!PZ.failed){PZ.failed=true;PZ.lives--;const was=PZ.streak;PZ.streak=0;const d=ratingChange(false,1);pop(`${d} rating`,x,y+30,'bad');pop('Raté !',x,y,'bad');if(was>=3)toast(`Série de ${was} perdue 💔`);}else pop('Pas celui-là…',x,y,'bad');
 puzHud();
 setTimeout(()=>{if(!PZ.active)return;if(PZ.lives<=0){PZ.busy=false;return runOver();}setPosition(prev,{last:BD.last,anim:{from:m.to,to:m.from}});PZ.busy=false;},750);}
function puzzleSolved(){PZ.done=true;PZ.busy=false;const p=PZ.cur,[x,y]=boardCenter();$('#pzHint').hidden=$('#pzSol').hidden=$('#pzSkip').hidden=true;$('#pzNext').hidden=false;
 Snd.mate();
 if(PZ.failed){banner('Résolu','mais sans points 😅');}
 else{PZ.streak++;PZ.run++;PZ.best=Math.max(PZ.best,PZ.streak);P.solved++;P.best=Math.max(P.best,PZ.streak);const d=ratingChange(true,PZ.hinted?.6:1);pop('+'+d+' rating',x,y+36,'good');
  const xp=Math.round((10+p.n*8+Math.min(PZ.streak,10)*3)*(PZ.hinted?.5:1));setTimeout(()=>Snd.correct(PZ.streak),250);
  const st=PZ.streak;FX.confetti(50+Math.min(st,12)*22,innerWidth/2,innerHeight*.35,1+st*.04);cls1(boardEl,'glow');vib(st>=5?[50,30,50,30,150]:[60]);
  const lines={3:['EN FEU !','🔥 3 d\'affilée'],5:['IMPARABLE !','⚡ 5 d\'affilée'],8:['MONSTRUEUX !','👹 8 d\'affilée'],10:['LÉGENDAIRE !','👑 10 d\'affilée'],15:['DIVIN !','🌟 15 d\'affilée'],20:['GRAND MAÎTRE !','🏆 20 d\'affilée']};
  if(lines[st]){banner(lines[st][0],lines[st][1]);FX.rain(60+st*5);}else banner('MAT !'+(p.n>1?' ✨':''),'Mat en '+p.n+' · x'+st);
  $('#combo').classList.remove('bump');void $('#combo').offsetWidth;$('#combo').classList.add('bump');
  addXP(xp,x,y-20);badge('first');if(st>=5)badge('s5');if(st>=10)badge('s10');if(p.n>=3)badge('m3');if(P.rating>=1200)badge('r1200');if(P.rating>=1600)badge('r1600');
  const q=quest();q.n++;if(q.n>=5&&!q.claimed){q.claimed=true;setTimeout(()=>{banner('QUÊTE DU JOUR ✅','+60 XP');FX.rain(120);addXP(60);},1500);}save();}
 puzHud();
 if(P.autonext&&!PZ.failed&&PZ.lives>0)PZ.timer=setTimeout(()=>{if(PZ.active&&PZ.done)nextPuzzle();},2300);}
function runOver(){PZ.active=false;Snd.lose();const gain=Math.round(P.rating-PZ.startRating);
 const b=openModal(`<h2 style="text-align:center">Série terminée 💔</h2><div class="card" style="text-align:center;margin:10px 0"><div class="big-r">${PZ.run}</div><div style="color:var(--mut)">puzzles résolus</div><p style="margin:8px 0 0">Meilleure série : <b>${PZ.best} 🔥</b> · Rating : <b>${Math.round(P.rating)}</b> (${gain>=0?'+':''}${gain}) · ${rankOf(P.rating)}</p></div>
 <div class="row" style="justify-content:center"><button class="btn pri" id="rAgain">⚡ Nouvelle série</button><button class="btn" id="rHome">🏠 Menu</button></div>`,{closable:false});
 b.querySelector('#rAgain').onclick=startPuzzles;b.querySelector('#rHome').onclick=()=>{closeModal(true);goHome();};}
$('#pzNext').onclick=()=>{if(PZ.active)nextPuzzle();};
$('#pzSkip').onclick=()=>{if(!PZ.active||PZ.done)return;if(!PZ.failed){PZ.streak=0;PZ.failed=true;ratingChange(false,1);}nextPuzzle();};
$('#pzHint').onclick=()=>{if(!PZ.active||PZ.done||PZ.busy)return;const cands=PZ.node?Object.keys(PZ.node):Chess.mateIn1Moves(PZ.state).map(uci);if(!cands.length)return;const mv=fromUci(PZ.state,cands[0]);PZ.hinted++;BD.hint=PZ.hinted>1?[mv.from,mv.to]:[mv.from];renderBoard();Snd.pop();toast(PZ.hinted>1?'Case de départ et d\'arrivée (points réduits)':'Voilà la pièce à jouer (points réduits)',2000);};
$('#pzSol').onclick=()=>{if(!PZ.active||PZ.done||PZ.busy)return;if(!PZ.failed){PZ.failed=true;PZ.lives--;PZ.streak=0;ratingChange(false,1);puzHud();}if(PZ.lives<=0)return runOver();PZ.busy=true;playSol(PZ.state,PZ.node);};
function playSol(s,node){const cands=node?Object.keys(node):Chess.mateIn1Moves(s).map(uci);if(!cands.length){PZ.busy=false;PZ.done=true;$('#pzNext').hidden=false;return;}
 const mv=fromUci(s,cands[0]),ns=apply(s,mv);PZ.state=ns;setPosition(ns,{last:{from:mv.from,to:mv.to},anim:{from:mv.from,to:mv.to}});Snd.move();
 if(inCheck(ns)&&!legal(ns).length){Snd.mate();PZ.busy=false;PZ.done=true;$('#pzNext').hidden=false;$('#pzHint').hidden=$('#pzSol').hidden=$('#pzSkip').hidden=true;return;}
 const ent=node[cands[0]];PZ.solTimer=setTimeout(()=>{const rm=fromUci(ns,ent[0]),s2=apply(ns,rm);PZ.state=s2;setPosition(s2,{last:{from:rm.from,to:rm.to},anim:{from:rm.from,to:rm.to}});PZ.solTimer=setTimeout(()=>playSol(s2,ent[1]),800);},800);}

/* ===== Menus de configuration ===== */
const TCS=['0','1+0','3+0','3+2','5+0','10+0','15+10'];
const tcChips=()=>TCS.map(t=>`<button class="chip" data-v="${t}">${t==='0'?'∞':t.replace('+','+')}</button>`).join('');
const parseTc=v=>{const[a,b]=v.split('+');return{m:+a||0,inc:+b||0};};
const colChips=`<button class="chip" data-v="r">🎲 Aléatoire</button><button class="chip" data-v="w">⚪ Blancs</button><button class="chip" data-v="b">⚫ Noirs</button>`;
function setupBot(){const b=openModal(`<h2>🤖 Contre l'ordinateur</h2><h4>Niveau</h4><div class="chips" id="lv"><button class="chip" data-v="1">😊 Débutant</button><button class="chip" data-v="2">🙂 Moyen</button><button class="chip" data-v="3">😤 Fort</button><button class="chip" data-v="4">🤖 Expert</button></div>
 <h4>Ta couleur</h4><div class="chips" id="co">${colChips}</div><h4>Cadence (minutes+incrément)</h4><div class="chips" id="tc">${tcChips()}</div><br><button class="btn pri" id="go" style="width:100%">Jouer ⚡</button>`);
 const gl=chips(b,'#lv','2'),gc=chips(b,'#co','r'),gt=chips(b,'#tc','0');
 b.querySelector('#go').onclick=()=>{const lv=+gl();let c=gc();if(c==='r')c=rnd(2)?'w':'b';const nm=['','Bot Débutant','Bot Moyen','Bot Fort','Bot Expert'][lv];startGame({mode:'bot',my:c,bot:c==='w'?'b':'w',level:lv,tc:parseTc(gt()),names:c==='w'?{w:P.name,b:nm}:{w:nm,b:P.name}});};}
function setupLocal(){const b=openModal(`<h2>🎲 Même écran</h2><h4>Cadence</h4><div class="chips" id="tc">${tcChips()}</div><div class="switch"><span>Retourner le plateau à chaque coup</span><button class="chip" id="af"></button></div><button class="btn pri" id="go" style="width:100%">Jouer ⚡</button>`);
 const gt=chips(b,'#tc','0'),af=b.querySelector('#af');const upd=()=>{af.textContent=P.autoflip?'Oui':'Non';af.classList.toggle('on',P.autoflip);};upd();af.onclick=()=>{P.autoflip=!P.autoflip;save();upd();};
 b.querySelector('#go').onclick=()=>startGame({mode:'local',tc:parseTc(gt()),names:{w:'Blancs',b:'Noirs'}});}
function setupNet(auto){const b=openModal(`<h2>👥 Jouer avec un ami</h2><h4>Créer un salon</h4><div class="chips" id="co">${colChips}</div><div class="chips" id="tc" style="margin-top:8px">${tcChips()}</div><button class="btn pri" id="mk" style="width:100%;margin-top:12px">✨ Créer le salon</button>
 <h4>Ou rejoindre</h4><div class="row" style="flex-wrap:nowrap"><input type="text" id="cd" maxlength="5" placeholder="CODE" autocomplete="off"><button class="btn pri" id="jn">Rejoindre</button></div>`);
 const gc=chips(b,'#co','r'),gt=chips(b,'#tc','0');
 b.querySelector('#mk').onclick=()=>{NET.pref=gc();NET.tc=parseTc(gt());netCreate();};
 const jn=()=>{const c=b.querySelector('#cd').value.trim();if(c.length<4)return toast('Entre le code à 5 caractères');netJoin(c);};b.querySelector('#jn').onclick=jn;b.querySelector('#cd').onkeydown=e=>{if(e.key==='Enter')jn();};}
function settings(){const th=[['classic','#eeeed2','#769656'],['wood','#f0d9b5','#b58863'],['ice','#dee3e6','#8ca2ad'],['neon','#2c3170','#171a45'],['candy','#ffe3f1','#ff8fc7'],['midnight','#9094b8','#4b4f78']];
 const sw=(k,l)=>`<div class="switch"><span>${l}</span><button class="chip" data-k="${k}"></button></div>`;
 const b=openModal(`<h2>⚙️ Réglages</h2><h4>Pseudo</h4><input type="text" class="nm-in" id="nm" maxlength="16" value="${P.name.replace(/"/g,'')}"><h4>Thème du plateau</h4><div class="themes">${th.map(t=>`<button class="th${P.theme===t[0]?' on':''}" data-t="${t[0]}"><i style="background:${t[1]}"></i><i style="background:${t[2]}"></i><i style="background:${t[2]}"></i><i style="background:${t[1]}"></i></button>`).join('')}</div>
 <h4>Options</h4>${sw('sound','Sons')}${sw('vibe','Vibrations')}${sw('fx','Effets maximum (confettis)')}${sw('autonext','Puzzle suivant automatique')}
 <h4>Badges</h4><div class="badges">${Object.entries(BADGES).map(([k,v])=>`<div class="bdg${P.badges.includes(k)?'':' off'}"><b>${v[0]}</b>${v[1]}</div>`).join('')}</div>
 <p style="color:var(--mut);font-size:13px;margin-top:12px">Parties : ${P.games} · Victoires : ${P.wins} · Puzzles : ${P.solved} · Meilleure série : ${P.best}</p>
 <div class="row"><button class="btn pri" id="ok">OK</button><button class="btn red" id="rs">Réinitialiser</button></div>`);
 const nm=b.querySelector('#nm');nm.onchange=()=>{P.name=nm.value.trim().slice(0,16)||P.name;save();hud();};
 b.querySelectorAll('.th').forEach(x=>x.onclick=()=>{P.theme=x.dataset.t;save();hud();b.querySelectorAll('.th').forEach(y=>y.classList.toggle('on',y===x));});
 b.querySelectorAll('[data-k]').forEach(x=>{const k=x.dataset.k,u=()=>{x.textContent=P[k]?'Oui':'Non';x.classList.toggle('on',!!P[k]);};u();x.onclick=()=>{P[k]=!P[k];save();u();Snd.pop();};});
 b.querySelector('#ok').onclick=()=>{nm.onchange();closeModal();};
 b.querySelector('#rs').onclick=()=>{if(confirm('Effacer toute ta progression ?')){try{localStorage.removeItem('rnr_profile');}catch(e){}location.reload();}};}
$('#btnSet').onclick=settings;$('#hudLvl').onclick=settings;
$$('.mode').forEach(m=>m.onclick=()=>{Snd.unlock();const g=m.dataset.go;g==='puz'?startPuzzles():g==='bot'?setupBot():g==='local'?setupLocal():setupNet();});

/* ===== Init ===== */
addEventListener('pointerdown',()=>Snd.unlock(),{once:true});
addEventListener('keydown',e=>{if(e.key==='Escape'&&!$('#modal').hidden)closeModal();
 if(G&&!$('#stage').hidden&&!G.over){if(e.key==='ArrowLeft')viewTo(G.view-1);if(e.key==='ArrowRight')viewTo(G.view+1);}
 if(PZ.active&&!$('#modal').hidden===false){if((e.key==='n'||e.key==='Enter'||e.key===' ')&&PZ.done){e.preventDefault();nextPuzzle();}if(e.key==='h')$('#pzHint').click();}});
$('#floaters').innerHTML=['♞','♛','♜','♝','♚','♟'].map((g,i)=>`<span style="left:${8+i*17}%;top:${10+(i%3)*28}%;animation-delay:${-i*1.3}s;color:hsl(${i*55} 80% 70%)">${g}</span>`).join('');
hud();quest();save();
const mRoom=location.hash.match(/room=([A-Za-z0-9]{4,6})/);
if(mRoom){setTimeout(()=>{netJoin(mRoom[1]);history.replaceState(null,'',location.pathname+location.search);},400);}

})();
</script>
