<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0a0d1c">
<title>Roque'n'Roll — Les échecs version dopamine</title>
<link rel="manifest" href="manifest.json">
<style>
:root{--h:265;--acc:hsl(var(--h) 95% 64%);--acc2:hsl(calc(var(--h) + 60) 95% 62%);--bg:#0a0d1c;--card:rgba(255,255,255,.06);--bd:rgba(255,255,255,.13);--tx:#eef0ff;--mut:#9aa3c7;--lt:#eeeed2;--dk:#769656}
body[data-theme=wood]{--lt:#f0d9b5;--dk:#b58863}
body[data-theme=ice]{--lt:#dee3e6;--dk:#8ca2ad}
body[data-theme=neon]{--lt:#2c3170;--dk:#171a45}
body[data-theme=candy]{--lt:#ffe3f1;--dk:#ff8fc7}
body[data-theme=midnight]{--lt:#9094b8;--dk:#4b4f78}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
[hidden]{display:none!important}
html,body{margin:0;min-height:100%;background:var(--bg);color:var(--tx);font:500 15px/1.4 ui-rounded,"SF Pro Rounded",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
body::before{content:"";position:fixed;inset:-20%;z-index:-1;background:radial-gradient(40% 40% at 20% 20%,hsl(var(--h) 90% 45% / .35),transparent 70%),radial-gradient(40% 40% at 80% 30%,hsl(calc(var(--h) + 80) 90% 45% / .28),transparent 70%),radial-gradient(50% 50% at 50% 90%,hsl(calc(var(--h) - 60) 90% 40% / .25),transparent 70%);animation:drift 18s ease-in-out infinite alternate}
@keyframes drift{to{transform:translate(4%,3%) scale(1.1)}}
button{font:inherit;color:inherit;cursor:pointer;border:0;background:none}
#fx{position:fixed;inset:0;pointer-events:none;z-index:80}
#layer{position:fixed;inset:0;pointer-events:none;z-index:85;overflow:hidden}
#top{display:flex;align-items:center;gap:10px;padding:10px 14px;max-width:1100px;margin:0 auto}
.logo{font-weight:900;font-size:19px;cursor:pointer;letter-spacing:-.3px}
.logo b{background:linear-gradient(90deg,var(--acc),var(--acc2));-webkit-background-clip:text;background-clip:text;color:transparent}
.grow{flex:1}
.ic{width:38px;height:38px;border-radius:12px;background:var(--card);border:1px solid var(--bd);font-size:18px}
.pill{padding:6px 12px;border-radius:99px;background:var(--card);border:1px solid var(--bd);font-weight:800;white-space:nowrap}
.lvl{display:flex;align-items:center;gap:8px;cursor:pointer}
.lvl>span{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;font-weight:900;background:linear-gradient(135deg,var(--acc),var(--acc2));color:#fff}
.xpbar{width:70px;height:8px;border-radius:9px;background:rgba(255,255,255,.12);overflow:hidden}
.xpbar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--acc),var(--acc2));transition:width .6s cubic-bezier(.2,.8,.2,1)}
main{max-width:1100px;margin:0 auto;padding:6px 14px 40px}
.hero{text-align:center;padding:18px 0 8px;position:relative}
.hero h1{font-size:clamp(34px,7vw,60px);margin:0;font-weight:900;letter-spacing:-1.5px}
.hero h1 span{color:var(--acc)}
.hero p{color:var(--mut);margin:6px 0 0;font-size:17px}
.floaters{position:absolute;inset:0;overflow:hidden;pointer-events:none;opacity:.35}
.floaters span{position:absolute;font-size:40px;animation:fl 9s ease-in-out infinite alternate}
@keyframes fl{from{transform:translateY(0) rotate(-12deg)}to{transform:translateY(-26px) rotate(14deg)}}
.card{background:var(--card);border:1px solid var(--bd);border-radius:20px;backdrop-filter:blur(10px);padding:16px}
.prof{display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin:14px 0}
.prof .av{width:54px;height:54px;border-radius:18px;display:grid;place-items:center;font-size:30px;background:linear-gradient(135deg,var(--acc),var(--acc2))}
.prof .info{flex:1;min-width:180px}
.prof .xpbar{width:100%;margin-top:6px;height:10px}
.quest{font-size:13px;color:var(--mut);margin-top:6px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}
.mode{display:block;text-align:left;padding:18px;border-radius:22px;background:var(--card);border:1px solid var(--bd);transition:transform .15s,border-color .15s,box-shadow .15s;position:relative;overflow:hidden}
.mode:hover{transform:translateY(-4px) scale(1.01);border-color:var(--acc);box-shadow:0 12px 40px -12px var(--acc)}
.mode .e{font-size:34px}.mode h3{margin:6px 0 2px;font-size:20px}.mode p{margin:0;color:var(--mut);font-size:14px}
.mode.big{grid-column:1/-1;background:linear-gradient(135deg,hsl(var(--h) 80% 40% / .55),hsl(calc(var(--h) + 70) 80% 40% / .45));border-color:transparent}
.tag{display:inline-block;margin-top:8px;font-size:12px;font-weight:800;padding:3px 10px;border-radius:99px;background:rgba(255,255,255,.18)}
.foot{text-align:center;color:var(--mut);font-size:12px;margin-top:22px}
#stage{display:grid;grid-template-columns:minmax(0,var(--bw)) minmax(300px,1fr);gap:18px;align-items:start;--bw:min(calc(100vh - 190px),680px)}
.colb{width:100%}
.boardwrap{position:relative}
#board{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));grid-template-rows:repeat(8,minmax(0,1fr));aspect-ratio:1;border-radius:12px;overflow:hidden;container-type:inline-size;touch-action:none;user-select:none;-webkit-user-select:none;box-shadow:0 20px 60px -20px hsl(var(--h) 90% 50% / .7),0 0 0 3px rgba(255,255,255,.08)}
#board.pop{animation:pop .5s cubic-bezier(.2,1.4,.4,1)}
#board.shake{animation:shake .45s}
#board.glow{animation:glow .9s}
@keyframes pop{from{transform:scale(.88) rotate(-1.5deg);opacity:0}to{transform:none;opacity:1}}
@keyframes shake{20%{transform:translateX(-10px)}40%{transform:translateX(9px)}60%{transform:translateX(-6px)}80%{transform:translateX(4px)}}
@keyframes glow{30%{box-shadow:0 0 0 4px #ffd23f,0 0 80px 10px #ffd23f}}
.sq{min-width:0;min-height:0;overflow:hidden;position:relative;display:flex;align-items:center;justify-content:center;cursor:pointer}
.sq.lt{background-color:var(--lt)}.sq.dk{background-color:var(--dk)}
.sq.last{box-shadow:inset 0 0 0 100px rgba(255,214,0,.30)}
.sq.sel{box-shadow:inset 0 0 0 100px rgba(255,230,60,.55)}
.sq.chk{background-image:radial-gradient(circle,rgba(255,40,40,.95) 0,rgba(255,40,40,.55) 35%,transparent 72%)}
.sq.mated{animation:mate .6s infinite alternate}
@keyframes mate{to{filter:brightness(1.6) saturate(2)}}
.sq.hint{animation:hint .8s infinite alternate}
@keyframes hint{to{box-shadow:inset 0 0 0 100px rgba(0,229,255,.55)}}
.sq.tgt::after{content:"";position:absolute;width:30%;height:30%;border-radius:50%;background:rgba(20,20,40,.32);z-index:3;pointer-events:none}
.sq.cap::after{content:"";position:absolute;inset:3%;border-radius:50%;border:.9cqw solid rgba(20,20,40,.35);z-index:3;pointer-events:none}
.pc{position:relative;z-index:2;display:flex;align-items:center;justify-content:center;width:100%;height:100%;line-height:1;pointer-events:none}
#board .pc{font-size:10.6cqw;padding-bottom:.4cqw}
.pc.w{color:#fff;-webkit-text-stroke:1.4px #1d1d28;text-shadow:0 2px 3px rgba(0,0,0,.45)}
.pc.b{color:#17171f;-webkit-text-stroke:1px #c3c7e0;text-shadow:0 2px 3px rgba(0,0,0,.45)}
.pc.ghosted{opacity:.25}
.ghost{position:fixed;pointer-events:none;z-index:60;display:flex;align-items:center;justify-content:center;transform:translate(-50%,-50%) scale(1.2);filter:drop-shadow(0 10px 8px rgba(0,0,0,.4));line-height:1}
.co{position:absolute;font-style:normal;font-size:max(9px,1.8cqw);font-weight:800;opacity:.7;pointer-events:none;z-index:1}
.co.rk{top:2px;left:3px}.co.fl{bottom:1px;right:3px}
.sq.lt .co{color:var(--dk)}.sq.dk .co{color:var(--lt)}
.pbar{display:flex;align-items:center;gap:10px;padding:8px 6px}
.pbar .av{width:34px;height:34px;border-radius:11px;display:grid;place-items:center;font-size:20px;background:var(--card);border:1px solid var(--bd)}
.pbar .nm{font-weight:800}.pbar .cp{color:var(--mut);font-size:15px;min-height:18px;letter-spacing:-2px}
.pbar .clk{margin-left:auto;font:800 20px ui-monospace,Menlo,monospace;padding:4px 12px;border-radius:10px;background:rgba(0,0,0,.35);min-width:84px;text-align:center}
.pbar.act .clk{background:linear-gradient(135deg,var(--acc),var(--acc2));color:#fff}
.pbar .clk.low{background:#e5383b!important;animation:pulse .5s infinite alternate}
@keyframes pulse{to{transform:scale(1.07)}}
.side{display:flex;flex-direction:column;gap:12px}
.status{font-weight:800;font-size:17px}
.moves{max-height:240px;overflow:auto;display:flex;flex-wrap:wrap;gap:2px 4px;font-size:14px;align-content:flex-start;min-height:60px}
.moves .n{color:var(--mut);margin-left:6px}.moves .m{padding:1px 6px;border-radius:6px;cursor:pointer}.moves .m.cur{background:var(--acc);color:#fff}
.row{display:flex;gap:8px;flex-wrap:wrap}
.btn{padding:10px 16px;border-radius:14px;background:var(--card);border:1px solid var(--bd);font-weight:800;transition:transform .12s}
.btn:hover{transform:translateY(-2px)}.btn:active{transform:scale(.96)}
.btn.pri{background:linear-gradient(135deg,var(--acc),var(--acc2));border-color:transparent;color:#fff;box-shadow:0 8px 24px -8px var(--acc)}
.btn.sm{padding:6px 12px;font-size:14px}.btn.red{background:#e5383b44}
.emos{display:flex;gap:6px;flex-wrap:wrap}.emos button{font-size:22px;width:44px;height:44px;border-radius:14px;background:var(--card);border:1px solid var(--bd)}
.emos button:active{transform:scale(1.3)}
#puzHud{display:flex;align-items:center;gap:14px;padding:6px 4px;flex-wrap:wrap}
.hearts{font-size:22px;letter-spacing:2px}
.combo{font-weight:900;font-size:22px;padding:4px 14px;border-radius:99px;background:linear-gradient(135deg,#ff7a18,#ff3d6e);color:#fff;transition:transform .2s}
.combo.bump{animation:bump .4s}
@keyframes bump{40%{transform:scale(1.45) rotate(-4deg)}}
.big-r{font-size:44px;font-weight:900;line-height:1}
.rank{font-weight:800;font-size:14px}
.modal{position:fixed;inset:0;z-index:90;display:grid;place-items:center;background:rgba(5,7,18,.7);backdrop-filter:blur(6px);padding:14px;animation:fade .2s}
@keyframes fade{from{opacity:0}}
.mbox{width:min(460px,100%);max-height:92vh;overflow:auto;background:#141831;border:1px solid var(--bd);border-radius:24px;padding:22px;animation:pop .35s cubic-bezier(.2,1.3,.4,1);box-shadow:0 30px 80px -20px #000}
.mbox h2{margin:0 0 6px;font-size:26px}.mbox h4{margin:14px 0 6px;color:var(--mut);font-size:13px;text-transform:uppercase;letter-spacing:1px}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chip{padding:8px 13px;border-radius:12px;background:var(--card);border:1px solid var(--bd);font-weight:800}
.chip.on{background:var(--acc);border-color:transparent;color:#fff}
input[type=text]{width:100%;padding:12px 14px;border-radius:14px;border:1px solid var(--bd);background:rgba(255,255,255,.07);color:var(--tx);font:800 18px ui-monospace,monospace;letter-spacing:3px;text-transform:uppercase}
input.nm-in{text-transform:none;letter-spacing:0;font-family:inherit}
.code{font:900 44px ui-monospace,monospace;letter-spacing:8px;text-align:center;padding:12px;border-radius:16px;background:rgba(255,255,255,.07);margin:10px 0}
.themes{display:flex;gap:8px;flex-wrap:wrap}.th{width:48px;height:48px;border-radius:12px;border:3px solid transparent;overflow:hidden;display:grid;grid-template-columns:1fr 1fr;padding:0}
.th.on{border-color:var(--acc)}.th i{display:block}
.promo{display:flex;gap:10px;justify-content:center}.promo button.pkw{color:#fff;-webkit-text-stroke:1.4px #222}.promo button.pkb{color:#17171f;-webkit-text-stroke:1px #c3c7e0}.promo button{font-size:54px;width:76px;height:76px;border-radius:18px;background:var(--card);border:1px solid var(--bd);line-height:1}
.switch{display:flex;justify-content:space-between;align-items:center;padding:8px 0}
.banner{position:fixed;left:50%;top:38%;transform:translate(-50%,-50%);z-index:88;font-size:clamp(34px,9vw,84px);font-weight:900;text-align:center;pointer-events:none;color:#fff;text-shadow:0 0 30px var(--acc),0 6px 0 rgba(0,0,0,.35);animation:banner 1.5s cubic-bezier(.2,1.2,.3,1) forwards;white-space:nowrap}
.banner small{display:block;font-size:.3em;opacity:.9}
@keyframes banner{0%{transform:translate(-50%,-50%) scale(.3) rotate(-8deg);opacity:0}18%{transform:translate(-50%,-50%) scale(1.15) rotate(2deg);opacity:1}30%{transform:translate(-50%,-50%) scale(1)}80%{opacity:1}100%{transform:translate(-50%,-80%) scale(1);opacity:0}}
.popup{position:fixed;z-index:87;font-weight:900;font-size:22px;pointer-events:none;animation:up 1.2s ease-out forwards;text-shadow:0 2px 6px rgba(0,0,0,.6);transform:translateX(-50%)}
.popup.xp{color:#ffd23f}.popup.good{color:#5dff9a}.popup.bad{color:#ff5d6c}
@keyframes up{to{transform:translate(-50%,-70px);opacity:0}}
.emo-f{position:fixed;font-size:46px;animation:emo 2.2s ease-out forwards;pointer-events:none}
@keyframes emo{to{transform:translateY(-220px) scale(1.5) rotate(15deg);opacity:0}}
.toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:95;background:#222845;border:1px solid var(--bd);padding:12px 18px;border-radius:14px;font-weight:700;animation:fade .2s;max-width:90vw;text-align:center}
.badges{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.bdg{text-align:center;padding:10px 4px;border-radius:14px;background:var(--card);font-size:12px}.bdg b{display:block;font-size:26px}.bdg.off{opacity:.3;filter:grayscale(1)}
.spin{display:inline-block;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
.dots::after{content:"";animation:dots 1.4s steps(4) infinite}@keyframes dots{0%{content:""}25%{content:"."}50%{content:".."}75%{content:"..."}}
@media(max-width:860px){#stage{grid-template-columns:1fr;--bw:100%}.colb{max-width:min(100%,640px);margin:0 auto}.xpbar{width:46px}.pill.hide-s{display:none}}
@media(prefers-reduced-motion:reduce){body::before,.floaters span{animation:none}}
</style>
</head>
<body data-theme="classic">
<canvas id="fx"></canvas><div id="layer"></div>
<div id="app">
<header id="top">
  <button class="ic" id="btnBack" hidden aria-label="Retour">←</button>
  <div class="logo" id="logo">♞ <b>Roque</b>'n'<b>Roll</b></div>
  <div class="grow"></div>
  <div class="pill" id="pillStreak" hidden>🔥 <b id="hudStreak">0</b></div>
  <div class="pill hide-s" id="pillRating">🏆 <b id="hudRating">800</b></div>
  <div class="lvl" id="hudLvl" title="Profil"><span id="lvlNum">1</span><div class="xpbar"><i id="xpFill"></i></div></div>
  <button class="ic" id="btnSet" aria-label="Réglages">⚙️</button>
</header>
<main>
<section id="home">
  <div class="hero"><div class="floaters" id="floaters"></div>
    <h1>Roque<span>'n'</span>Roll</h1>
    <p>Les échecs, mais avec <b>beaucoup trop</b> de dopamine.</p></div>
  <div class="card prof" id="profCard">
    <div class="av">♞</div>
    <div class="info"><div><b id="pName">Joueur</b> · <span id="pTitle"></span></div><div class="xpbar"><i id="pXp"></i></div><div class="quest" id="pQuest"></div></div>
    <div style="text-align:right"><div class="big-r" id="pRating">800</div><div class="rank" id="pRank"></div></div>
  </div>
  <div class="grid">
    <button class="mode big" data-go="puz"><div class="e">🧩</div><h3>Puzzles Rush</h3><p>Plus tu réussis, plus ça devient dur. Séries, combos, rangs, quête du jour.</p><span class="tag">⚡ DIFFICULTÉ ADAPTATIVE</span></button>
    <button class="mode" data-go="net"><div class="e">👥</div><h3>Jouer avec un ami</h3><p>Crée un salon, envoie le lien ou le code. Zéro inscription.</p></button>
    <button class="mode" data-go="bot"><div class="e">🤖</div><h3>Contre l'ordinateur</h3><p>4 niveaux, du débutant à l'expert.</p></button>
    <button class="mode" data-go="local"><div class="e">🎲</div><h3>Même écran</h3><p>À deux sur le même appareil.</p></button>
  </div>
  <div class="foot">Roque'n'Roll · règles complètes (roque, prise en passant, promotion, nulles) · progression sauvegardée sur ton appareil</div>
</section>

<section id="stage" hidden>
  <div class="colb">
    <div class="pbar" id="barTop"><div class="av">♚</div><div><div class="nm"></div><div class="cp"></div></div><div class="clk"></div></div>
    <div id="puzHud" hidden>
      <div class="hearts" id="hearts"></div><div class="combo" id="combo">🔥 x0</div>
      <div style="margin-left:auto;text-align:right"><div class="big-r" id="zRating" style="font-size:30px">800</div><div class="rank" id="zRank"></div></div>
    </div>
    <div class="boardwrap"><div id="board"></div></div>
    <div class="pbar" id="barBot"><div class="av">♔</div><div><div class="nm"></div><div class="cp"></div></div><div class="clk"></div></div>
  </div>
  <aside class="side">
    <div class="card" id="panelGame">
      <div class="status" id="status"></div>
      <div class="moves" id="moves"></div>
      <div class="row" style="margin-top:10px">
        <button class="btn sm" id="nFirst">⏮</button><button class="btn sm" id="nPrev">◀</button><button class="btn sm" id="nNext">▶</button><button class="btn sm" id="nLast">⏭</button>
        <button class="btn sm" id="btnFlip">🔄 Retourner</button>
      </div>
      <div class="row" style="margin-top:8px">
        <button class="btn sm" id="btnUndo">↩️ Annuler</button>
        <button class="btn sm" id="btnDraw">🤝 Nulle</button>
        <button class="btn sm red" id="btnResign">🏳️ Abandonner</button>
        <button class="btn sm" id="btnPgn">📋 PGN</button>
      </div>
      <div id="reactions" hidden style="margin-top:12px"><div class="emos"><button data-e="👏">👏</button><button data-e="😂">😂</button><button data-e="😱">😱</button><button data-e="🔥">🔥</button><button data-e="💀">💀</button><button data-e="🤝">🤝</button><button data-e="GG">GG</button></div></div>
    </div>
    <div class="card" id="panelPuzzle" hidden>
      <div class="status" id="pzTitle"></div>
      <p id="pzPrompt" style="color:var(--mut);margin:6px 0 12px"></p>
      <div class="row">
        <button class="btn pri" id="pzNext" hidden>Puzzle suivant →</button>
        <button class="btn" id="pzHint">💡 Indice</button>
        <button class="btn" id="pzSol">👁 Solution</button>
        <button class="btn" id="pzSkip">⏭ Passer</button>
      </div>
      <div class="quest" id="pzQuest" style="margin-top:12px"></div>
      <div class="quest" id="pzRun"></div>
    </div>
  </aside>
</section>
</main>
