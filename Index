            if (r === startR && !b[(r + 2 * dir) * 8 + c]) add(i, (r + 2 * dir) * 8 + c, 'd');
          }
        }
        for (const dc of [-1, 1]) {
          const cc = c + dc; if (cc < 0 || cc > 7) continue;
          const t = r1 * 8 + cc, q = b[t];
          if (q && colorOf(q) !== me) { if (r1 === lastR) for (const pr of 'qrbn') add(i, t, 'x', pr); else add(i, t, 'x'); }
          else if (!q && t === ep) add(i, t, 'e');
        }
      } else if (up === 'N' || up === 'K') {
        for (const [dr, dc] of up === 'N' ? KN : KG) {
          const rr = r + dr, cc = c + dc;
          if (rr < 0 || rr > 7 || cc < 0 || cc > 7) continue;
          const t = rr * 8 + cc, q = b[t];
          if (!q) add(i, t); else if (colorOf(q) !== me) add(i, t, 'x');
        }
        if (up === 'K') {
          if (me === 'w' && i === 60) {
            if (cast.includes('K') && !b[61] && !b[62] && b[63] === 'R' && !attacked(b, 60, opp) && !attacked(b, 61, opp) && !attacked(b, 62, opp)) add(60, 62, 'k');
            if (cast.includes('Q') && !b[59] && !b[58] && !b[57] && b[56] === 'R' && !attacked(b, 60, opp) && !attacked(b, 59, opp) && !attacked(b, 58, opp)) add(60, 58, 'q');
          }
          if (me === 'b' && i === 4) {
            if (cast.includes('k') && !b[5] && !b[6] && b[7] === 'r' && !attacked(b, 4, opp) && !attacked(b, 5, opp) && !attacked(b, 6, opp)) add(4, 6, 'k');
