    const cand = pool.filter(x => x[1] >= top - cfg.noise * (0.5 + Math.random()));
    if (cfg.noise && cand.length) {
      return cand[Math.floor(Math.random() * Math.min(cand.length, 3 + (cfg.noise > 100 ? 4 : 0)))][0];
    }
    return pool[0][0];
  }

  // ---------- Solveur de mats (pour les puzzles) ----------
  function givesCheck(s, m) { const ns = apply(s, m); return inCheck(ns, ns.turn) ? ns : null; }
