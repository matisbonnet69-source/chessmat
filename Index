      else if (u === 'n') v += CENTER(i) * 9;
      else if (u === 'b') { v += CENTER(i) * 5; bishops[w ? 'w' : 'b']++; }
      else if (u === 'q') v += CENTER(i) * 1.5;
      else if (u === 'k') { v += (w ? (r === 7 ? 12 : 0) : (r === 0 ? 12 : 0)); }
      sc += w ? v : -v;
    }
    if (bishops.w >= 2) sc += 25; if (bishops.b >= 2) sc -= 25;
    return s.turn === 'w' ? sc : -sc;
  }
  function order(s, ms) {
    return ms.map(m => {
      let sc = 0; const tgt = s.b[m.to], p = s.b[m.from];
      if (tgt) sc += 10 * VAL[tgt.toLowerCase()] - VAL[p.toLowerCase()] / 10;
      if (m.fl === 'e') sc += 900;
      if (m.promo) sc += VAL[m.promo] + 500;
      return [sc, m];
    }).sort((a, z) => z[0] - a[0]).map(x => x[1]);
  }
