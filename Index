  if(BD.sel===i)cl+=' sel';
  if(BD.targets.has(i))cl+=p?' cap':' tgt';
  if(BD.chk===i)cl+=' chk';if(BD.mated===i)cl+=' mated';if(BD.hint.includes(i))cl+=' hint';
  s.className=cl;s.dataset.i=i;
  let h='';if(p)h+=`<span class="pc ${isW(p)?'w':'b'}">${GL[p.toUpperCase()]}</span>`;
  if((d&7)===0)h+=`<i class="co rk">${8-r}</i>`;if(d>=56)h+=`<i class="co fl">${'abcdefgh'[c]}</i>`;
  s.innerHTML=h;}
 if(anim)animatePiece(anim.from,anim.to,anim.rook);}
function animatePiece(from,to){const dF=BD.flip?63-from:from,dT=BD.flip?63-to:to,el=boardEl.children[dT].querySelector('.pc');if(!el)return;
