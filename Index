    let scored = order(s, ms).map(m => [m, 0]);
    let lastGood = null;
    for (let d = 1; d <= cfg.d; d++) {
      const cur = [];
      let alpha = -Infinity;
      for (const [m] of scored) {
        const sc = -ab(apply(s, m), d - 1, -Infinity, -alpha + (cfg.noise ? 1e9 : 0), 1);
