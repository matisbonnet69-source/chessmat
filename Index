      if (m.fl === 'x' || m.fl === 'e') str += FILES[m.from & 7] + 'x';
      str += sqName(m.to);
      if (m.promo) str += '=' + m.promo.toUpperCase();
    } else {
      str += up;
      const others = lm.filter(o => o !== m && s.b[o.from] === p && o.to === m.to);
