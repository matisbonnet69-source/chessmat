function renderBoard(anim){const st=BD.state,kids=boardEl.children;
 for(let d=0;d<64;d++){const i=BD.flip?63-d:d,s=kids[d],p=st.b[i],r=i>>3,c=i&7;
  let cl='sq '+(((r+c)&1)?'dk':'lt');
