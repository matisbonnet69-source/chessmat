function startDrag(e,i,p){const g=document.createElement('div');g.className='ghost pc '+(isW(p)?'w':'b');g.textContent=GL[p.toUpperCase()];const sz=boardEl.clientWidth/8;g.style.width=g.style.height=sz+'px';g.style.fontSize=(sz*.84)+'px';document.body.appendChild(g);
