    const ns = apply(s, m);
    if (inCheck(ns)) str += legal(ns).length ? '+' : '#';
    return str;
  }
  const uci = m => sqName(m.from) + sqName(m.to) + (m.promo || '');
  const findMove = (s, from, to, promo) => legal(s).find(m => m.from === from && m.to === to && (m.promo || '') === (promo || ''));
  const fromUci = (s, u) => legal(s).find(m => uci(m) === u);

  // ---------- IA ----------
  const VAL = { p: 100, n: 320, b: 335, r: 500, q: 900, k: 0 };
  const CENTER = i => { const r = i >> 3, c = i & 7; return 3 - Math.max(Math.abs(r - 3.5) - 0.5, Math.abs(c - 3.5) - 0.5); };
  function evaluate(s) {
